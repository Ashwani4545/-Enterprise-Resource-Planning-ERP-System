# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL (configure your database connection)
DATABASE_URL=postgresql://erp_user:erp_password@localhost:5432/erp_system
# Alternatively, discrete params (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_system
DB_USER=erp_user
DB_PASSWORD=erp_password

# Auth
JWT_SECRET=your-super-secret-jwt-key-replace-this-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-replace-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12
